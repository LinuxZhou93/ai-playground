"use client";

import React from "react";
import { 
  ShieldAlert, 
  BrainCircuit, 
  Zap, 
  ArrowRight, 
  TrendingDown, 
  Users,
  AlertCircle,
  Sparkles,
  Loader2
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { StaggerContainer, StaggerItem } from "@/components/erp/page-transition";
import { AnimatedNumber } from "@/components/erp/animated-number";
import { motion } from "motion/react";

interface DiagnosisBoardProps {
  diagnosis: any;
  directive: string;
  loading: boolean;
}

export default function DiagnosisBoard({ diagnosis, directive, loading }: DiagnosisBoardProps) {
  if (loading) {
    return (
      <Card className="col-span-full border-none shadow-xl bg-muted/30 backdrop-blur-sm overflow-hidden">
        <div className="h-[200px] flex items-center justify-center gap-3">
          <div className="relative">
            <Loader2 className="h-8 w-8 animate-spin text-indigo-500" />
            <div className="absolute inset-0 h-8 w-8 rounded-full bg-indigo-500/20 animate-ping" />
          </div>
          <span className="text-muted-foreground font-medium">智能运营大脑正在深度扫描资产...</span>
        </div>
      </Card>
    );
  }

  if (!diagnosis) return null;

  return (
    <Card className="col-span-full border-none shadow-2xl bg-card overflow-hidden group">
      {/* 顶部渐变条 */}
      <div className="h-1.5 w-full bg-gradient-to-r from-red-500 via-amber-500 to-indigo-600" />
      
      <CardHeader className="pb-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            <motion.div
              initial={{ rotate: -10, scale: 0.8 }}
              animate={{ rotate: 0, scale: 1 }}
              transition={{ type: "spring", bounce: 0.4 }}
              className="p-2 bg-indigo-500 rounded-lg text-white shadow-lg shadow-indigo-500/30"
            >
              <BrainCircuit className="h-5 w-5" />
            </motion.div>
            <div>
              <CardTitle className="text-xl font-bold">智能运营诊断</CardTitle>
              <CardDescription className="flex items-center gap-1">
                数据扫描时间: {new Date(diagnosis.timestamp).toLocaleTimeString()} · <span className="text-emerald-500">资产状态异常检测已完成</span>
              </CardDescription>
            </div>
          </div>
          <motion.div
            initial={{ scale: 0 }}
            animate={{ scale: 1 }}
            transition={{ type: "spring", bounce: 0.5, delay: 0.3 }}
          >
            <Badge variant="outline" className="bg-red-500/10 text-red-600 border-red-500/20">
              发现 {diagnosis.dormantCount + diagnosis.inefficientClassesCount} 个风险项
            </Badge>
          </motion.div>
        </div>
      </CardHeader>

      <CardContent className="grid md:grid-cols-12 gap-6">
        {/* 左侧：风险雷达 */}
        <div className="md:col-span-5 space-y-4">
          <StaggerContainer className="grid grid-cols-2 gap-3">
            <StaggerItem>
              <div className="p-4 rounded-xl bg-red-500/5 border border-red-500/10 group-hover:shadow-md transition-shadow">
                <div className="flex items-center justify-between mb-2">
                  <Users className="h-4 w-4 text-red-500" />
                  <span className="text-[10px] font-bold text-red-400">HIGH RISK</span>
                </div>
                <p className="text-2xl font-black text-red-600">
                  <AnimatedNumber value={diagnosis.dormantCount} />
                </p>
                <p className="text-xs text-red-500 font-medium">沉睡学员 (14d+)</p>
              </div>
            </StaggerItem>
            
            <StaggerItem>
              <div className="p-4 rounded-xl bg-amber-500/5 border border-amber-500/10 group-hover:shadow-md transition-shadow">
                <div className="flex items-center justify-between mb-2">
                  <TrendingDown className="h-4 w-4 text-amber-500" />
                  <span className="text-[10px] font-bold text-amber-400">WARN</span>
                </div>
                <p className="text-2xl font-black text-amber-600">
                  <AnimatedNumber value={diagnosis.riskRevenue} prefix="¥" />
                </p>
                <p className="text-xs text-amber-500 font-medium">预计流失营收</p>
              </div>
            </StaggerItem>
          </StaggerContainer>

          <div className="p-4 rounded-xl border bg-muted/30">
            <h4 className="text-sm font-semibold mb-3 flex items-center gap-2">
              <AlertCircle className="h-4 w-4 text-muted-foreground" /> 沉睡黑名单 (流失前预警)
            </h4>
            <div className="space-y-2">
              {diagnosis.dormantList.length > 0 ? (
                diagnosis.dormantList.map((s: any, idx: number) => (
                  <motion.div
                    key={s.id}
                    initial={{ opacity: 0, x: -10 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ delay: 0.4 + idx * 0.08 }}
                    className="flex items-center justify-between p-2 bg-card rounded-lg shadow-sm border"
                  >
                    <span className="text-sm font-medium">{s.name}</span>
                    <Badge variant="secondary" className="text-[10px] px-1.5 py-0">
                      最后消课: {s.lastDate}
                    </Badge>
                  </motion.div>
                ))
              ) : (
                <p className="text-xs text-center text-muted-foreground py-2">暂无极高危沉睡学员 ✨</p>
              )}
            </div>
          </div>
        </div>

        {/* 右侧：AI 指令区 */}
        <div className="md:col-span-7 flex flex-col">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.5, duration: 0.5 }}
            className="flex-1 p-5 rounded-2xl bg-gradient-to-br from-indigo-600 to-indigo-800 text-white relative overflow-hidden shadow-xl shadow-indigo-500/20"
          >
            {/* 背景修饰 */}
            <Sparkles className="absolute top-2 right-2 h-20 w-20 text-white/5 -rotate-12" />
            <motion.div
              animate={{ y: [0, -6, 0] }}
              transition={{ duration: 5, repeat: Infinity, ease: "easeInOut" }}
              className="absolute -bottom-4 -left-4 h-24 w-24 bg-white/10 rounded-full blur-2xl"
            />
            
            <div className="relative z-10">
              <div className="flex items-center gap-2 mb-4">
                <div className="p-1.5 bg-white/20 rounded-full backdrop-blur-md">
                  <Zap className="h-4 w-4 fill-amber-400 text-amber-400" />
                </div>
                <h3 className="font-bold tracking-wide">AI 运营指挥指令</h3>
              </div>
              
              <div className="text-indigo-50 leading-relaxed text-sm italic min-h-[100px]">
                {`" ${directive} "`}
              </div>

              <div className="mt-6 flex gap-3">
                <Button size="sm" className="bg-white text-indigo-700 hover:bg-indigo-50 font-bold border-none">
                  立即下发任务
                </Button>
                <Button size="sm" variant="outline" className="border-indigo-400/50 text-white hover:bg-white/10">
                  生成跟进报表 <ArrowRight className="ml-2 h-4 w-4" />
                </Button>
              </div>
            </div>
          </motion.div>
        </div>
      </CardContent>
    </Card>
  );
}
