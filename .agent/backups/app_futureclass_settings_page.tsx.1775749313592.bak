"use client";

import React, { useState } from "react";
import { 
  School2, 
  Bell, 
  Database, 
  Save,
  Loader2,
  Globe,
  Key,
  Cpu,
  ChevronRight,
  ShieldCheck,
  Zap
} from "lucide-react";
import { 
  Card, 
  CardContent, 
  CardHeader, 
  CardTitle,
  CardDescription,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { toast } from "sonner";
import { useSettingsStore } from "@/lib/store/settings";
import { PROVIDERS } from "@/lib/ai/providers";
import { PageTransition, StaggerContainer, StaggerItem } from "@/components/erp/page-transition";
import { motion, AnimatePresence } from "motion/react";

export default function SettingsPage() {
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);
  const { providerId, modelId, setModel, providersConfig } = useSettingsStore();

  const [config, setConfig] = useState({
    orgName: "FutureClass STEM 科创中心",
    orgPhone: "028-8888-6666",
    orgAddress: "成都市高新区天府四街 199号",
    notifyWechat: true,
    notifySms: false,
    aiModel: modelId || "gemini-3-flash-preview",
    aiProxy: "backgrace.com",
    lessonsPerSession: 1,
    warningThreshold: 3,
  });

  const handleModelChange = (val: string) => {
    setConfig({ ...config, aiModel: val });
    setModel('google', val);
  };

  const availableModels = providersConfig['google']?.models || [
    { id: 'gemini-3-flash-preview', name: 'Gemini 3 Flash Preview' },
    { id: 'gemini-3-flash-search', name: 'Gemini 3 Flash Search' },
    { id: 'gemini-3-flash-thinking', name: 'Gemini 3 Flash Thinking' }
  ];

  const handleSave = async () => {
    setSaving(true);
    await new Promise(r => setTimeout(r, 800));
    setSaving(false);
    setSaved(true);
    toast.success("设置已保存 ✅", {
      style: {
        background: "rgba(255, 255, 255, 0.8)",
        backdropFilter: "blur(8px)",
        border: "1px solid rgba(0, 0, 0, 0.05)"
      }
    });
    setTimeout(() => setSaved(false), 2000);
  };

  const sections = [
    {
      icon: School2,
      title: "机构信息",
      description: "配置你的机构基本资料与物理地址",
      color: "slate",
      content: (
        <div className="space-y-5">
          <div className="space-y-2 group">
            <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">机构名称</label>
            <Input 
              className="bg-white/50 border-slate-200/60 focus:bg-white focus:ring-2 focus:ring-slate-900/5 transition-all duration-300" 
              value={config.orgName} 
              onChange={e => setConfig({...config, orgName: e.target.value})} 
            />
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">联系电话</label>
              <Input 
                className="bg-white/50 border-slate-200/60 focus:bg-white transition-all duration-300" 
                value={config.orgPhone} 
                onChange={e => setConfig({...config, orgPhone: e.target.value})} 
              />
            </div>
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">地址</label>
              <Input 
                className="bg-white/50 border-slate-200/60 focus:bg-white transition-all duration-300" 
                value={config.orgAddress} 
                onChange={e => setConfig({...config, orgAddress: e.target.value})} 
              />
            </div>
          </div>
        </div>
      )
    },
    {
      icon: Cpu,
      title: "AI 引擎配置",
      description: "管理 Titan Engine 核心模型与全球代理网关",
      color: "zinc",
      content: (
        <div className="space-y-5">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">AI 模型 (Titan Engine)</label>
              <div className="relative">
                <Select value={config.aiModel} onValueChange={handleModelChange}>
                  <SelectTrigger className="w-full bg-white/50 border-slate-200/60 hover:bg-white transition-all duration-300">
                    <SelectValue placeholder="选择模型" />
                  </SelectTrigger>
                  <SelectContent className="backdrop-blur-xl bg-white/90">
                    {availableModels.map(m => (
                      <SelectItem key={m.id} value={m.id} className="focus:bg-slate-100 transition-colors">
                        {m.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                <div className="absolute right-10 top-1/2 -translate-y-1/2 flex items-center gap-1.5 pointer-events-none">
                  <span className="relative flex h-2 w-2">
                    <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span className="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                  </span>
                  <Badge variant="secondary" className="bg-emerald-50 text-emerald-700 border-emerald-100/50 text-[10px] px-1.5 py-0">ACTIVE</Badge>
                </div>
              </div>
            </div>
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">代理网关</label>
              <div className="relative">
                <Input 
                  className="bg-white/50 border-slate-200/60 focus:bg-white pl-8 transition-all duration-300" 
                  value={config.aiProxy} 
                  onChange={e => setConfig({...config, aiProxy: e.target.value})} 
                />
                <Globe className="absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" />
              </div>
            </div>
          </div>
          <motion.div 
            initial={{ opacity: 0, y: 5 }}
            animate={{ opacity: 1, y: 0 }}
            className="p-3.5 rounded-xl bg-slate-50 border border-slate-200/50 flex items-start gap-3"
          >
            <div className="mt-0.5 p-1 bg-white rounded-md shadow-sm border border-slate-100">
              <ShieldCheck className="h-3.5 w-3.5 text-slate-600" />
            </div>
            <p className="text-xs text-slate-500 leading-relaxed">
              <span className="font-semibold text-slate-700">安全注入:</span> API 密钥已通过 AES-256 环境变量加密注入。为了您的数据安全，生产环境密钥在前端不可见。
            </p>
          </motion.div>
        </div>
      )
    },
    {
      icon: Bell,
      title: "通知与推送",
      description: "控制家校互联渠道与自动化消息流",
      color: "slate",
      content: (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <motion.div 
            whileHover={{ y: -2 }}
            className="flex items-center justify-between p-4 rounded-2xl bg-white border border-slate-100 shadow-[0_2px_10px_rgba(0,0,0,0.02)] transition-all"
          >
            <div className="space-y-0.5">
              <p className="text-[13px] font-semibold text-slate-800">微信服务号推送</p>
              <p className="text-[11px] text-slate-400">课后报告实时同步</p>
            </div>
            <button 
              onClick={() => setConfig({...config, notifyWechat: !config.notifyWechat})}
              className={`w-10 h-5.5 rounded-full transition-all duration-300 relative ${config.notifyWechat ? 'bg-slate-900 shadow-inner' : 'bg-slate-200'}`}
            >
              <motion.span
                animate={{ x: config.notifyWechat ? 18 : 2 }}
                transition={{ type: "spring", stiffness: 500, damping: 30 }}
                className="absolute top-0.5 w-4.5 h-4.5 rounded-full bg-white shadow-md"
              />
            </button>
          </motion.div>
          <motion.div 
            whileHover={{ y: -2 }}
            className="flex items-center justify-between p-4 rounded-2xl bg-white border border-slate-100 shadow-[0_2px_10px_rgba(0,0,0,0.02)] transition-all"
          >
            <div className="space-y-0.5">
              <p className="text-[13px] font-semibold text-slate-800">短信通知</p>
              <p className="text-[11px] text-slate-400">关键财务变更提醒</p>
            </div>
            <button 
              onClick={() => setConfig({...config, notifySms: !config.notifySms})}
              className={`w-10 h-5.5 rounded-full transition-all duration-300 relative ${config.notifySms ? 'bg-slate-900 shadow-inner' : 'bg-slate-200'}`}
            >
              <motion.span
                animate={{ x: config.notifySms ? 18 : 2 }}
                transition={{ type: "spring", stiffness: 500, damping: 30 }}
                className="absolute top-0.5 w-4.5 h-4.5 rounded-full bg-white shadow-md"
              />
            </button>
          </motion.div>
        </div>
      )
    },
    {
      icon: Database,
      title: "消课规则",
      description: "配置自动化课时扣减逻辑与库存预警",
      color: "zinc",
      content: (
        <div className="space-y-5">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">每次签到扣减课时</label>
              <Input 
                type="number" 
                className="bg-white/50 border-slate-200/60 focus:bg-white transition-all duration-300" 
                value={config.lessonsPerSession} 
                onChange={e => setConfig({...config, lessonsPerSession: Number(e.target.value)})} 
              />
            </div>
            <div className="space-y-2 group">
              <label className="text-[13px] font-medium text-slate-500 group-focus-within:text-slate-900 transition-colors">预警阈值（剩余课时）</label>
              <Input 
                type="number" 
                className="bg-white/50 border-slate-200/60 focus:bg-white transition-all duration-300" 
                value={config.warningThreshold} 
                onChange={e => setConfig({...config, warningThreshold: Number(e.target.value)})} 
              />
            </div>
          </div>
          <div className="p-4 rounded-2xl bg-gradient-to-br from-slate-50 to-zinc-100/50 border border-slate-200/40">
            <div className="flex items-center gap-2 mb-2">
              <Zap className="h-3.5 w-3.5 text-amber-500 fill-amber-500" />
              <span className="text-[11px] font-bold uppercase tracking-wider text-slate-400">智能预警逻辑</span>
            </div>
            <p className="text-xs text-slate-500 leading-relaxed">
              当学员剩余课时 <span className="font-mono font-bold text-slate-900">≤ {config.warningThreshold}</span> 时，系统将在 Dashboard 
              自动触发 <span className="text-red-500 font-medium">高优先级预警</span> 并标记为续费跟进状态。
            </p>
          </div>
        </div>
      )
    }
  ];

  return (
    <PageTransition>
      <div className="space-y-8 max-w-4xl mx-auto pb-20">
        {/* Header Section */}
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-100 pb-8">
          <div className="space-y-1">
            <div className="flex items-center gap-2 text-slate-400 text-xs font-medium uppercase tracking-[0.2em] mb-1">
              <div className="h-[1px] w-4 bg-slate-300" />
              System Configuration
            </div>
            <h2 className="text-3xl font-bold tracking-tight text-slate-900">系统设置</h2>
            <p className="text-slate-500 text-sm">管理 FutureClass 全局运行参数与 AI 核心引擎</p>
          </div>
          
          <Button 
            onClick={handleSave} 
            disabled={saving} 
            className={`
              relative overflow-hidden min-w-[140px] h-11 rounded-full transition-all duration-500
              ${saved ? 'bg-emerald-500 hover:bg-emerald-600' : 'bg-slate-900 hover:bg-slate-800'}
              shadow-[0_10px_20px_rgba(0,0,0,0.1)] hover:shadow-[0_15px_25px_rgba(0,0,0,0.15)]
              active:scale-95
            `}
          >
            <AnimatePresence mode="wait">
              {saving ? (
                <motion.span 
                  key="saving" 
                  initial={{ opacity: 0, y: 10 }} 
                  animate={{ opacity: 1, y: 0 }} 
                  exit={{ opacity: 0, y: -10 }} 
                  className="flex items-center gap-2"
                >
                  <Loader2 className="h-4 w-4 animate-spin" /> 
                  <span className="text-sm font-medium">正在同步...</span>
                </motion.span>
              ) : saved ? (
                <motion.span
                  key="saved"
                  initial={{ scale: 0.8, opacity: 0 }}
                  animate={{ scale: 1, opacity: 1 }}
                  exit={{ opacity: 0 }}
                  className="flex items-center gap-2"
                >
                  <motion.div
                    initial={{ scale: 0 }}
                    animate={{ scale: 1 }}
                    transition={{ type: "spring", damping: 12 }}
                  >
                    ✅
                  </motion.div>
                  <span className="text-sm font-medium text-white">配置已更新</span>
                </motion.span>
              ) : (
                <motion.span 
                  key="default" 
                  initial={{ opacity: 0 }} 
                  animate={{ opacity: 1 }} 
                  exit={{ opacity: 0 }} 
                  className="flex items-center gap-2"
                >
                  <Save className="h-4 w-4 opacity-80" /> 
                  <span className="text-sm font-medium">保存全局设置</span>
                </motion.span>
              )}
            </AnimatePresence>
          </Button>
        </div>

        {/* Main Content Sections */}
        <StaggerContainer className="space-y-8">
          {sections.map((section, i) => (
            <StaggerItem key={i}>
              <Card className="group relative overflow-hidden border-none bg-white/40 backdrop-blur-sm shadow-[0_1px_3px_rgba(0,0,0,0.02),0_10px_40px_-12px_rgba(0,0,0,0.04)] hover:shadow-[0_1px_3px_rgba(0,0,0,0.02),0_20px_60px_-12px_rgba(0,0,0,0.08)] transition-all duration-500">
                <div className="absolute top-0 left-0 w-1 h-full bg-slate-900/0 group-hover:bg-slate-900 transition-all duration-500" />
                <CardHeader className="pb-6">
                  <div className="flex items-start justify-between">
                    <div className="flex items-center gap-4">
                      <div className="relative">
                        <div className="absolute inset-0 bg-slate-900/5 blur-xl rounded-full group-hover:bg-slate-900/10 transition-colors" />
                        <div className="relative p-3 rounded-2xl bg-white border border-slate-100 shadow-sm text-slate-900 group-hover:scale-110 transition-transform duration-500">
                          <section.icon className="h-5 w-5" />
                        </div>
                      </div>
                      <div>
                        <CardTitle className="text-lg font-bold text-slate-900 tracking-tight">{section.title}</CardTitle>
                        <CardDescription className="text-xs text-slate-400 mt-0.5">{section.description}</CardDescription>
                      </div>
                    </div>
                    <ChevronRight className="h-4 w-4 text-slate-200 group-hover:text-slate-400 group-hover:translate-x-1 transition-all" />
                  </div>
                </CardHeader>
                <CardContent className="relative z-10">
                  {section.content}
                </CardContent>
              </Card>
            </StaggerItem>
          ))}
        </StaggerContainer>

        {/* System Info Footer */}
        <motion.div
          initial={{ opacity: 0 }}
          whileInView={{ opacity: 1 }}
          viewport={{ once: true }}
        >
          <Card className="bg-slate-50/50 border-dashed border-slate-200 shadow-none overflow-hidden">
            <CardContent className="p-8">
              <div className="flex items-center gap-2 mb-6">
                <div className="h-1.5 w-1.5 rounded-full bg-slate-400 animate-pulse" />
                <h4 className="font-bold text-[11px] uppercase tracking-[0.2em] text-slate-500 flex items-center gap-2">
                  System Environment Info
                </h4>
              </div>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-8">
                {[
                  { label: "版本", value: "v2.0.0-stable", icon: "📦" },
                  { label: "框架", value: "Next.js 15.1", icon: "⚡" },
                  { label: "数据库", value: "PostgreSQL", icon: "🗄️" },
                  { label: "AI 引擎", value: "Gemini 3 Flash", icon: "🧠" }
                ].map((item, idx) => (
                  <div key={idx} className="space-y-1.5">
                    <span className="text-[11px] font-medium text-slate-400">{item.label}</span>
                    <div className="flex items-center gap-2">
                      <span className="text-[10px] grayscale opacity-50">{item.icon}</span>
                      <p className="font-mono text-[13px] font-bold text-slate-700 tracking-tight">{item.value}</p>
                    </div>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        </motion.div>
      </div>
    </PageTransition>
  );
}
