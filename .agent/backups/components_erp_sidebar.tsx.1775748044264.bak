"use client";

import React from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import {
  LayoutDashboard,
  Users,
  BookOpen,
  CheckCircle2,
  GraduationCap,
  CreditCard,
  Settings,
  ChevronLeft,
  ChevronRight,
  Menu,
  X,
  AlertTriangle,
  Activity,
} from "lucide-react";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { motion, AnimatePresence, LayoutGroup } from "framer-motion";
import { getDashboardStats } from "@/app/futureclass/actions";

const menuItems = [
  { name: "教务看板", icon: LayoutDashboard, path: "/futureclass/dashboard" },
  { name: "学员管理", icon: Users, path: "/futureclass/students" },
  { name: "日常点名", icon: CheckCircle2, path: "/futureclass/attendance" },
  { name: "课程库", icon: BookOpen, path: "/futureclass/courses" },
  { name: "班级管理", icon: GraduationCap, path: "/futureclass/classes" },
  { name: "财务中心", icon: CreditCard, path: "/futureclass/finance" },
  { name: "系统设置", icon: Settings, path: "/futureclass/settings" },
];

export function ERPSidebar() {
  const pathname = usePathname();
  const [collapsed, setCollapsed] = React.useState(false);
  const [mobileOpen, setMobileOpen] = React.useState(false);

  // V2.1: 实时 KPI 微组件
  const [kpi, setKpi] = React.useState<{ studentCount: number; warningCount: number } | null>(null);
  React.useEffect(() => {
    getDashboardStats().then(data => setKpi(data)).catch(() => {});
  }, []);

  // 路由变化时关闭移动端菜单
  React.useEffect(() => {
    setMobileOpen(false);
  }, [pathname]);

  const sidebarContent = (isMobile: boolean) => (
    <div className="flex flex-col h-full bg-zinc-950/5 backdrop-blur-xl">
      {/* Logo 区 - Linear 风格极简设计 */}
      <div className="flex items-center gap-3 px-6 h-20 border-b border-zinc-200/50 dark:border-zinc-800/50 overflow-hidden">
        <motion.div 
          whileHover={{ scale: 1.05 }}
          whileTap={{ scale: 0.95 }}
          className="h-10 w-10 rounded-xl bg-gradient-to-br from-zinc-800 to-zinc-950 dark:from-emerald-500 dark:to-teal-600 flex items-center justify-center text-white shadow-2xl shadow-emerald-500/20 shrink-0 border border-white/10"
        >
          <GraduationCap className="h-6 w-6" />
        </motion.div>
        <AnimatePresence mode="wait">
          {(!collapsed || isMobile) && (
            <motion.div
              initial={{ opacity: 0, x: -10 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -10 }}
              className="flex flex-col"
            >
              <span className="font-bold text-lg tracking-tighter text-zinc-900 dark:text-zinc-100 leading-none">
                FutureClass
              </span>
              <span className="text-[10px] font-medium text-emerald-600 dark:text-emerald-400 tracking-widest uppercase opacity-80">
                Enterprise
              </span>
            </motion.div>
          )}
        </AnimatePresence>
        {isMobile && (
          <Button 
            variant="ghost" 
            size="icon" 
            className="ml-auto rounded-full hover:bg-zinc-200/50 dark:hover:bg-zinc-800/50" 
            onClick={() => setMobileOpen(false)}
          >
            <X className="h-5 w-5 text-zinc-500" />
          </Button>
        )}
      </div>

      {/* 导航菜单 - 增加 LayoutGroup 保证平滑过渡 */}
      <nav className="flex-1 overflow-y-auto py-6 px-3 space-y-1.5 custom-scrollbar">
        <LayoutGroup>
          {menuItems.map((item) => {
            const isActive = pathname === item.path || pathname?.startsWith(item.path + "/");
            return (
              <Link key={item.path} href={item.path} className="block group">
                <div className="relative px-3 py-2.5 rounded-xl transition-all duration-300 ease-out flex items-center gap-3 overflow-hidden">
                  {/* Active Indicator Background */}
                  {isActive && (
                    <motion.div
                      layoutId={isMobile ? "sidebar-active-mobile" : "sidebar-active"}
                      className="absolute inset-0 bg-white dark:bg-zinc-800 shadow-[0_1px_3px_rgba(0,0,0,0.1),0_1px_2px_rgba(0,0,0,0.06)] dark:shadow-none border border-zinc-200 dark:border-zinc-700/50"
                      transition={{ type: "spring", bounce: 0.2, duration: 0.6 }}
                    />
                  )}
                  
                  {/* Hover Effect */}
                  {!isActive && (
                    <div className="absolute inset-0 opacity-0 group-hover:opacity-100 bg-zinc-200/40 dark:bg-zinc-800/40 transition-opacity rounded-xl" />
                  )}

                  <item.icon
                    className={cn(
                      "h-5 w-5 shrink-0 relative z-10 transition-all duration-300",
                      isActive 
                        ? "text-emerald-600 dark:text-emerald-400 scale-110" 
                        : "text-zinc-500 group-hover:text-zinc-900 dark:group-hover:text-zinc-100"
                    )}
                  />
                  
                  <AnimatePresence mode="wait">
                    {(!collapsed || isMobile) && (
                      <motion.span
                        initial={{ opacity: 0, x: -5 }}
                        animate={{ opacity: 1, x: 0 }}
                        exit={{ opacity: 0, x: -5 }}
                        className={cn(
                          "text-sm font-medium relative z-10 tracking-tight",
                          isActive 
                            ? "text-zinc-900 dark:text-zinc-100" 
                            : "text-zinc-500 group-hover:text-zinc-900 dark:group-hover:text-zinc-100"
                        )}
                      >
                        {item.name}
                      </motion.span>
                    )}
                  </AnimatePresence>

                  {isActive && (
                    <motion.div 
                      layoutId="active-dot"
                      className="absolute right-3 w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.6)]" 
                    />
                  )}
                </div>
              </Link>
            );
          })}
        </LayoutGroup>
      </nav>

      {/* V2.5: AI 引擎运行状态监控区 - 极客玻璃拟物化 */}
      <AnimatePresence>
        {(!collapsed || isMobile) && (
          <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: 10 }}
            className="mx-4 mb-4"
          >
            <div className="group relative rounded-2xl p-4 overflow-hidden bg-zinc-900 dark:bg-zinc-900/40 border border-white/5 shadow-2xl">
              <div className="absolute top-0 right-0 p-2 opacity-20 group-hover:opacity-40 transition-opacity">
                <Activity className="h-12 w-12 text-emerald-500 -mr-4 -mt-4 rotate-12" />
              </div>
              <div className="relative z-10">
                <div className="flex items-center gap-2 mb-2">
                  <div className="relative flex h-2 w-2">
                    <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                    <span className="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                  </div>
                  <span className="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">Titan Core</span>
                </div>
                <div className="space-y-1">
                  <p className="text-xs font-semibold text-zinc-100">Auto-Agent Active</p>
                  <p className="text-[10px] text-zinc-500 flex items-center gap-1">
                    <AlertTriangle className="h-3 w-3 text-amber-500/80" />
                    API 503 — 节点降级重试中
                  </p>
                </div>
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* V2.1: KPI 微组件 - 数字化看板风格 */}
      <AnimatePresence>
        {(!collapsed || isMobile) && kpi && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            className="mx-4 mb-6 grid grid-cols-2 gap-2"
          >
            <div className="bg-white dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 p-3 rounded-2xl shadow-sm">
              <p className="text-[10px] text-zinc-500 font-medium mb-1 uppercase tracking-wider">在读学员</p>
              <p className="text-lg font-bold text-zinc-900 dark:text-zinc-100 font-mono tracking-tighter">
                {kpi.studentCount.toLocaleString()}
              </p>
            </div>
            <div className="bg-white dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 p-3 rounded-2xl shadow-sm">
              <p className="text-[10px] text-zinc-500 font-medium mb-1 uppercase tracking-wider">异常预警</p>
              <div className="flex items-baseline gap-1">
                <p className={cn(
                  "text-lg font-bold font-mono tracking-tighter",
                  kpi.warningCount > 0 ? "text-rose-500" : "text-emerald-500"
                )}>
                  {kpi.warningCount}
                </p>
                {kpi.warningCount > 0 && (
                  <span className="flex h-1.5 w-1.5 rounded-full bg-rose-500 animate-pulse" />
                )}
              </div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* 底部控制栏 */}
      <div className="p-4 border-t border-zinc-200/50 dark:border-zinc-800/50 flex flex-col items-center gap-4">
        <AnimatePresence>
          {(!collapsed || isMobile) && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"
            >
              <div className="w-1 h-1 rounded-full bg-emerald-500" />
              <span className="text-[10px] text-zinc-500 font-mono font-medium tracking-tight">
                SYSTEM v2.1.0_STABLE
              </span>
            </motion.div>
          )}
        </AnimatePresence>
        
        {!isMobile && (
          <Button
            variant="ghost"
            size="icon"
            onClick={() => setCollapsed(!collapsed)}
            className="h-9 w-9 rounded-xl hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors group"
          >
            <motion.div
              animate={{ rotate: collapsed ? 180 : 0 }}
              transition={{ type: "spring", stiffness: 300, damping: 20 }}
            >
              <ChevronLeft className="h-5 w-5 text-zinc-500 group-hover:text-zinc-900 dark:group-hover:text-zinc-100" />
            </motion.div>
          </Button>
        )}
      </div>
    </div>
  );

  return (
    <>
      {/* 移动端汉堡按钮 - 悬浮玻璃态 */}
      <motion.button
        whileHover={{ scale: 1.05 }}
        whileTap={{ scale: 0.95 }}
        className="fixed top-4 left-4 z-50 md:hidden p-2.5 rounded-2xl bg-white/80 dark:bg-zinc-900/80 backdrop-blur-xl border border-zinc-200 dark:border-zinc-800 shadow-xl shadow-black/5"
        onClick={() => setMobileOpen(true)}
      >
        <Menu className="h-5 w-5 text-zinc-700 dark:text-zinc-300" />
      </motion.button>

      {/* 移动端抽屉覆盖层 */}
      <AnimatePresence>
        {mobileOpen && (
          <>
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              className="fixed inset-0 bg-zinc-950/40 backdrop-blur-sm z-40 md:hidden"
              onClick={() => setMobileOpen(false)}
            />
            <motion.div
              initial={{ x: "-100%" }}
              animate={{ x: 0 }}
              exit={{ x: "-100%" }}
              transition={{ type: "spring", damping: 28, stiffness: 220 }}
              className="fixed top-0 left-0 z-50 w-[280px] h-screen bg-white dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 flex flex-col md:hidden shadow-2xl"
            >
              {sidebarContent(true)}
            </motion.div>
          </>
        )}
      </AnimatePresence>

      {/* 桌面端侧边栏 - 动态宽度与平滑阴影 */}
      <motion.div
        className={cn(
          "relative flex-col h-screen border-r border-zinc-200/60 dark:border-zinc-800/60 bg-white dark:bg-zinc-950 hidden md:flex z-30",
          "shadow-[1px_0_0_0_rgba(0,0,0,0.02),8px_0_24px_-12px_rgba(0,0,0,0.03)]"
        )}
        animate={{ width: collapsed ? 84 : 280 }}
        transition={{ duration: 0.45, ease: [0.23, 1, 0.32, 1] }}
      >
        {sidebarContent(false)}
      </motion.div>
    </>
  );
}
