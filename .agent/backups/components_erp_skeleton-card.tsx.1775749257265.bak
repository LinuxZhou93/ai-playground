"use client";

import React from "react";
import { cn } from "@/lib/utils";

/**
 * Shimmer 基础占位条
 */
function Shimmer({ className }: { className?: string }) {
  return (
    <div
      className={cn(
        "relative overflow-hidden rounded-md bg-muted/60",
        "before:absolute before:inset-0 before:-translate-x-full",
        "before:animate-[shimmer_1.5s_infinite]",
        "before:bg-gradient-to-r before:from-transparent before:via-white/40 before:to-transparent",
        className
      )}
    />
  );
}

/**
 * KPI 卡片骨架屏
 */
export function SkeletonKPI() {
  return (
    <div className="rounded-xl border bg-card p-6 shadow-sm space-y-4">
      <div className="flex items-center justify-between">
        <Shimmer className="h-4 w-24" />
        <Shimmer className="h-9 w-9 rounded-lg" />
      </div>
      <Shimmer className="h-10 w-28" />
      <Shimmer className="h-3 w-36" />
    </div>
  );
}

/**
 * 通用内容卡片骨架屏
 */
export function SkeletonCard({ lines = 3 }: { lines?: number }) {
  return (
    <div className="rounded-xl border bg-card p-6 shadow-sm space-y-4">
      <div className="flex items-center gap-3">
        <Shimmer className="h-10 w-10 rounded-lg" />
        <div className="space-y-2 flex-1">
          <Shimmer className="h-4 w-32" />
          <Shimmer className="h-3 w-48" />
        </div>
      </div>
      {Array.from({ length: lines }).map((_, i) => (
        <Shimmer key={i} className="h-3" style={{ width: `${85 - i * 12}%` } as React.CSSProperties} />
      ))}
    </div>
  );
}

/**
 * 表格行骨架屏
 */
export function SkeletonTable({ rows = 5, cols = 6 }: { rows?: number; cols?: number }) {
  return (
    <div className="space-y-3 p-4">
      {Array.from({ length: rows }).map((_, r) => (
        <div key={r} className="flex gap-4 items-center">
          {Array.from({ length: cols }).map((_, c) => (
            <Shimmer
              key={c}
              className="h-4 flex-1"
              style={{ maxWidth: c === 0 ? '80px' : undefined } as React.CSSProperties}
            />
          ))}
        </div>
      ))}
    </div>
  );
}

/**
 * 图表区域骨架屏
 */
export function SkeletonChart() {
  return (
    <div className="w-full h-[300px] flex items-end gap-2 p-6">
      {Array.from({ length: 7 }).map((_, i) => (
        <Shimmer
          key={i}
          className="flex-1 rounded-t-md"
          style={{ height: `${30 + Math.random() * 60}%` } as React.CSSProperties}
        />
      ))}
    </div>
  );
}
