                    // Render Function
                    function renderSkills() {
                        const isVIP = window.SubscriptionManager && window.SubscriptionManager.isSubscribed();

                        skillGrid.innerHTML = skills.map(s => {
                            // If user is VIP, premium items are unlocked
                            const isLocked = s.locked && !isVIP;
                            const alertScript = "alert('🔒 该课程暂未解锁，请完成前置课程或升级会员等级。')";
                            const clickAction = isLocked ? alertScript : "alert('🚀 即将进入课程: " + s.name + "')";

                            return `
                        <div class="skill-node ${isLocked ? 'locked' : ''}" onclick="${clickAction}">
                            <div class="sn-icon">${s.icon}</div>
                            <div class="sn-label">${s.name}</div>
                            ${ isLocked ? '<div class="sn-lock">🔒</div>' : '' }
                        </div>
                        `;
                        }).join('');
                    }

                    // Initial Render
                    renderSkills();

                    // Listen for Subscription Updates
                    window.addEventListener('subscription_updated', () => {
                        console.log('SkillTree: Subscription Updated, Re-rendering...');
                        renderSkills();
                    });
                });
            </script>
        </div>
