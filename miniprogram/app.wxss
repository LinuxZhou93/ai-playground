page {
  min-height: 100vh;
  color: #1f2a24;
  background:
    radial-gradient(circle at 10% 0%, rgba(198, 154, 73, 0.14), transparent 34%),
    #f6f0e6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

image {
  display: block;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.page-shell {
  padding: 24rpx 24rpx 40rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin: 34rpx 4rpx 18rpx;
}

.section-title text:first-child {
  color: #173d2b;
  font-size: 34rpx;
  font-weight: 900;
}

.section-title text:last-child {
  color: #8f7442;
  font-size: 22rpx;
  font-weight: 700;
}

.zby-card {
  border: 1rpx solid rgba(31, 42, 36, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 250, 242, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(31, 42, 36, 0.08);
  overflow: hidden;
}

.zby-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  color: #251909;
  background: linear-gradient(135deg, #f3d38a, #c69a49);
  font-size: 26rpx;
  font-weight: 900;
}

.zby-btn.ghost {
  color: #173d2b;
  background: rgba(23, 61, 43, 0.08);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #173d2b;
  background: rgba(111, 140, 79, 0.11);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 42rpx;
}
