/** app.wxss **/
page {
  /* --- Cyber Design Tokens --- */
  --primary: #00f0ff;
  --secondary: #7000ff;
  --accent: #ff003c;
  --success: #00ff9d;
  --dark: #050510;
  --panel-bg: rgba(15, 20, 35, 0.75);
  --warm: #ffd600;
  
  background-color: var(--dark);
  color: white;
  font-family: -apple-system, 'Inter', 'Noto Sans SC', sans-serif;
  height: 100%;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
  background: radial-gradient(circle at center, #090e1e 0%, #000 100%);
}

/* --- Cyber Scanline (赛博扫描线) --- */
.cyber-scanline {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), 
              linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
  background-size: 100% 3rpx, 3rpx 100%;
  pointer-events: none;
  z-index: 10000;
  opacity: 0.12;
}

/* --- Glass Panel (赛博玻璃面板) --- */
.glass-panel {
  background: var(--panel-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.5);
}

.glass-panel::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  border-top: 2rpx solid var(--primary);
  border-right: 2rpx solid var(--primary);
  border-top-right-radius: 32rpx;
  opacity: 0.5;
}

/* --- HUD Corner Elements --- */
.hud-corner {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid var(--primary);
  opacity: 0.3;
}

.tl { top: 20rpx; left: 20rpx; border-right: none; border-bottom: none; }
.tr { top: 20rpx; right: 20rpx; border-left: none; border-bottom: none; }
.bl { bottom: 20rpx; left: 20rpx; border-right: none; border-top: none; }
.br { bottom: 20rpx; right: 20rpx; border-left: none; border-top: none; }

/* --- Global Utilities --- */
.text-primary { color: var(--primary); }
.text-warm { color: var(--warm); }
.glow { text-shadow: 0 0 10rpx var(--primary); }
