/* pages/ai-lab/index.wxss */

.header {
  padding: 40rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  display: block;
}

.subtitle {
  font-size: 18rpx;
  color: var(--primary);
  opacity: 0.7;
}

.lab-stage {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 60rpx;
}

/* --- Core Animation --- */
.core-node {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.core-icon {
  font-size: 80rpx;
  z-index: 10;
  filter: drop-shadow(0 0 20rpx var(--primary));
}

.ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid var(--primary);
}

.ring-1 {
  width: 100%; height: 100%;
  border-style: dashed;
  animation: spin 15s linear infinite;
  opacity: 0.3;
}

.ring-2 {
  width: 80%; height: 80%;
  border-width: 4rpx;
  border-top-color: transparent;
  border-bottom-color: transparent;
  animation: spin 3s ease-in-out infinite reverse;
  opacity: 0.6;
}

/* --- Progress --- */
.progress-info {
  width: 100%;
  text-align: center;
}

.percent {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--primary);
  display: block;
}

.status-msg {
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 2rpx;
  margin: 20rpx 0;
  display: block;
}

.progress-bar-wrap {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 240, 255, 0.1);
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--success));
  box-shadow: 0 0 20rpx var(--primary);
  transition: width 0.5s ease;
}

/* --- Logs --- */
.log-panel {
  width: 100%;
  height: 300rpx;
  padding: 30rpx !important;
}

.panel-header {
  font-size: 18rpx;
  font-weight: 800;
  color: #64748b;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 10rpx;
}

.log-content {
  height: 200rpx;
}

.log-line {
  font-family: monospace;
  font-size: 18rpx;
  color: #94a3b8;
  line-height: 1.8;
}

.log-line.active {
  color: var(--success);
  text-shadow: 0 0 10rpx var(--success);
}

/* --- Controls --- */
.control-grid {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.control-btn {
  flex: 1;
  padding: 30rpx !important;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  color: var(--primary);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
