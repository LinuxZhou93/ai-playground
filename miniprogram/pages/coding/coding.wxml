<view class="container">
  <view class="header">
    <text class="title">Choose Your Studio</text>
    <text class="subtitle">全能在线开发环境，云端一键编译</text>
  </view>

  <view class="grid">
    <view class="card bg-glass" wx:for="{{ides}}" wx:key="id" bindtap="onTapItem" data-id="{{item.id}}">
      <view class="icon-box" style="background: {{item.color}}20; color: {{item.color}}">
        <text class="icon">{{item.icon}}</text>
      </view>
      <text class="card-name">{{item.name}}</text>
      <text class="card-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
