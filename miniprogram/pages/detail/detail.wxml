<!--pages/detail/detail.wxml-->
<view class="container">
  <view class="hero-section">
    <view class="title-box">
      <text class="module-title">{{info.title}}</text>
      <view class="line"></view>
    </view>
    <text class="module-desc">{{info.desc}}</text>
  </view>

  <view class="course-list">
    <view class="section-header">课程列表 / CURRICULUM</view>
    
    <block wx:if="{{info.courses.length > 0}}">
      <view class="course-card bg-glass" wx:for="{{info.courses}}" wx:key="name" bindtap="onStartCourse" data-index="{{index}}">
        <view class="course-info">
          <text class="course-name">{{item.name}}</text>
          <view class="tags">
            <text class="tag tag-{{item.status === '进行中' ? 'active' : 'normal'}}">{{item.tag}}</text>
          </view>
        </view>
        <view class="course-status">
          <text class="status-text">{{item.status}}</text>
          <view class="arrow">></view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state">
        <text>暂无课程数据</text>
      </view>
    </block>
  </view>
</view>
