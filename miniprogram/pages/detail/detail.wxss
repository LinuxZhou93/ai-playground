/* pages/detail/detail.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background-color: #050b14;
}

.hero-section {
  width: 100%;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.1) 0%, rgba(5, 11, 20, 0) 100%);
  margin-bottom: 40rpx;
}

.title-box {
  margin-bottom: 20rpx;
}

.module-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 0 10px rgba(34, 211, 238, 0.6);
  font-family: 'Times New Roman', Times, serif; /* Stylistic choice for headlines */
}

.line {
  width: 100rpx;
  height: 6rpx;
  background: #22d3ee;
  margin-top: 10rpx;
  box-shadow: 0 0 8px #22d3ee;
}

.module-desc {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* Course List */
.course-list {
  width: 100%;
  padding: 0 30rpx;
}

.section-header {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 30rpx;
  letter-spacing: 2rpx;
  font-weight: bold;
}

.course-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 25rpx;
  border-radius: 12rpx;
  border-left: 2px solid transparent;
  transition: all 0.2s;
}

.course-card:active {
  background: rgba(30, 41, 59, 0.9);
}

.course-info {
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 32rpx;
  color: #e2e8f0;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.tags {
  display: flex;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(148, 163, 184, 0.2);
  color: #94a3b8;
}

.tag-active {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 1px solid rgba(34, 211, 238, 0.3);
}

.course-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 24rpx;
  color: #64748b;
  margin-right: 15rpx;
}

.arrow {
  color: #475569;
  font-weight: bold;
}
