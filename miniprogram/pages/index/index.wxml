<view class="container">
  <!-- Background Image -->
  <image class="bg-image" src="/images/bg.jpg" mode="aspectFill"></image>
  
  <!-- Status Bar (Custom Mock) -->
  <view class="status-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="server-info">SERVER: {{userInfo.server}}</view>
    <view class="ping-info">PING: {{userInfo.ping}}</view>
  </view>

  <!-- Main Content -->
  <view class="main-content">
    
    <!-- Hero / Avatar Section -->
    <view class="hero-section">
      <view class="avatar-container">
        <image class="avatar-glow" src="/images/logo.png"></image>
        <view class="popover">你好，我是你的AI教练！</view>
      </view>
      
      <view class="welcome-text">
        <view class="h1">欢迎来到我的世界。</view>
        <view class="h2">正在加载区块...</view>
        <view class="h2">让我们一起探索未来世界</view>
      </view>
    </view>

    <!-- Stats Section -->
    <view class="stats-panel glass-panel">
      <view class="panel-header">
        <text>>> 学习进度条</text>
        <view class="ai-tag">✨ AI分析</view>
      </view>
      
      <view class="progress-list">
        <view class="progress-item" wx:for="{{stats}}" wx:key="label">
          <view class="p-header">
            <text class="p-label">{{item.label}}</text>
            <text class="p-value">{{item.value}}%</text>
          </view>
          <view class="p-bar-bg">
            <view class="p-bar-fill" style="{{ 'width:' + item.value + '%; background:' + item.color }}"></view>
          </view>
        </view>
      </view>

      <view class="panel-header" style="margin-top: 30rpx;">
        <text>>> SKILL_TREE // 技能树</text>
        <view class="ai-tag btn-action">🤖 AI规划</view>
      </view>
      
      <!-- Skill Tree Graphic Placeholder -->
      <view class="skill-tree-graphic">
        <view class="node node-math">数学</view>
        <view class="node node-phy">物理</view>
        <view class="node node-info">信息</view>
      </view>
    </view>

  </view>

  <!-- Bottom Dock -->
  <view class="dock-container glass-panel">
    <scroll-view class="dock-scroll" scroll-x="true" enable-flex="true">
      <view class="dock-item" wx:for="{{dockItems}}" wx:key="id" bindtap="onDockItemTap" data-item="{{item}}">
        <view class="dock-icon-box" style="border-color: {{item.id === 'coding' ? '#FFAB19' : '#00f3ff'}}">
          <text class="dock-icon">{{item.icon}}</text>
        </view>
        <text class="dock-label">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>
</view>
