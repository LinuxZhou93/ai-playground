/** index.wxss **/
.container {
  min-height: 100vh;
  background-color: #000;
  color: #fff;
  font-family: 'Courier New', Courier, monospace;
  position: relative;
  overflow: hidden;
  padding-bottom: 180rpx; /* Space for Dock */
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.3;
}

.status-bar {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.5);
  font-size: 20rpx;
  color: #0f0;
  border-bottom: 1px solid #0f0;
}

.main-content {
  position: relative;
  z-index: 10;
  padding: 40rpx;
}

.hero-section {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 60rpx;
}

.avatar-container {
  position: relative;
  margin-right: 40rpx;
}

.avatar-glow {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx solid #00f3ff;
  box-shadow: 0 0 20rpx rgba(0, 243, 255, 0.5);
}

.popover {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  color: #000;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  white-space: nowrap;
  font-weight: bold;
}
.popover::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #fff;
}

.welcome-text .h1 {
  font-size: 36rpx;
  font-weight: bold;
  color: #00f3ff;
  margin-bottom: 10rpx;
}
.welcome-text .h2 {
  font-size: 28rpx;
  color: #0f0;
  margin-bottom: 6rpx;
}

/* Glass Panel */
.glass-panel {
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0, 243, 255, 0.3);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  color: #0f0;
  font-size: 24rpx;
}

.ai-tag {
  background: linear-gradient(90deg, #7c3aed, #db2777);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
}

/* Progress Bars */
.progress-item {
  margin-bottom: 24rpx;
}

.p-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 8rpx;
  color: #fff;
}

.p-bar-bg {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.p-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 1s ease-in-out;
}

/* Skill Tree Graphics */
.skill-tree-graphic {
  position: relative;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.node {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  border: 2rpx solid #0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #0f0;
  box-shadow: 0 0 10rpx rgba(0, 255, 0, 0.3);
}

/* Dock */
.dock-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.8);
  border-top: 1px solid #333;
  padding: 20rpx 0;
  z-index: 100;
  /* Reset glass panel specifics for dock */
  border-radius: 0; 
  border: none;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.dock-scroll {
  display: flex;
  white-space: nowrap;
  width: 100%;
}

.dock-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
  width: 100rpx;
}

.dock-item:first-child {
  margin-left: 30rpx;
}
.dock-item:last-child {
  margin-right: 30rpx;
}

.dock-icon-box {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  border: 2rpx solid #00f3ff;
  transition: all 0.2s;
}

.dock-item:active .dock-icon-box {
  transform: scale(0.9);
  background: rgba(0, 243, 255, 0.3);
}

.dock-icon {
  font-size: 40rpx;
}

.dock-label {
  font-size: 18rpx;
  color: #94a3b8;
}
