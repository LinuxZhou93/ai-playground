/* pages/index/index.wxss */

/* --- News Ticker (资讯条) --- */
.news-ticker {
  position: fixed;
  left: 0;
  right: 0;
  height: 60rpx;
  background: rgba(0, 10, 20, 0.8);
  border-bottom: 1rpx solid rgba(0, 240, 255, 0.2);
  z-index: 1000;
  display: flex;
  align-items: center;
}

.news-label {
  background: var(--primary);
  color: #000;
  height: 100%;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: 10rpx 0 20rpx rgba(0, 240, 255, 0.3);
}

.ticker-content {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

.ticker-move {
  display: inline-block;
  animation: ticker 20s linear infinite;
}

.news-item {
  margin-right: 100rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

@keyframes ticker {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

/* --- Main Stage Layout --- */
.main-stage {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.glass-panel {
  margin-bottom: 30rpx;
  padding: 40rpx;
}

/* --- Profile Card --- */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, rgba(15, 20, 35, 0.8) 0%, rgba(5, 5, 16, 0.9) 100%);
}

.avatar-box {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 40rpx rgba(0, 240, 255, 0.4);
}

.avatar-orbit {
  position: absolute;
  top: -20rpx; left: -20rpx; right: -20rpx; bottom: -20rpx;
  border: 2rpx dashed var(--primary);
  border-radius: 50%;
  animation: spin 10s linear infinite;
  opacity: 0.4;
}

.user-meta {
  text-align: center;
}

.u-name {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  display: block;
}

.u-rank {
  font-size: 20rpx;
  color: var(--warm);
  border: 1rpx solid var(--warm);
  padding: 4rpx 20rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin: 16rpx 0;
  background: rgba(255, 214, 0, 0.1);
}

.u-uid {
  font-size: 18rpx;
  color: #666;
  display: block;
}

/* --- Skill Grid --- */
.skill-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.skill-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
}

.s-icon { font-size: 40rpx; }
.s-name { font-size: 20rpx; color: #94a3b8; }

.s-bar-bg {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.s-bar {
  height: 100%;
  background: var(--primary);
  box-shadow: 0 0 10rpx var(--primary);
}

/* --- Lab Card (AIGC) --- */
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--primary);
}

.status-pill {
  font-size: 18rpx;
  color: var(--success);
  border: 1rpx solid var(--success);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.cyber-textarea {
  width: 100%;
  height: 180rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(0, 240, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
}

.cyber-btn {
  margin-top: 30rpx;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 30rpx rgba(0, 240, 255, 0.3);
}

/* --- Dock Bar --- */
.dock-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 9999;
}

.dock-bar {
  background: rgba(10, 15, 30, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  display: flex;
  gap: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.6);
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.dock-item image {
  width: 48rpx;
  height: 48rpx;
}

.dock-item text {
  font-size: 18rpx;
  color: #94a3b8;
  font-weight: 700;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
