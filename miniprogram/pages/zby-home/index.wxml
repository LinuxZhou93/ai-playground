<view class="page-shell">
  <view class="hero zby-card">
    <image class="hero-bg" src="/images/zhenboyuan/base-row.jpg" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-content">
      <image class="hero-logo" src="/images/zhenboyuan/logo.png" mode="aspectFit" />
      <text class="hero-kicker">{{brand.subtitle}}</text>
      <text class="hero-title">{{brand.name}}</text>
      <text class="hero-copy">{{brand.slogan}}</text>
      <view class="hero-actions">
        <button class="zby-btn" bindtap="goMall">进入商城</button>
        <button class="zby-btn ghost" bindtap="goTrace">查溯源</button>
      </view>
    </view>
  </view>

  <view class="quick-grid">
    <button class="quick-card" bindtap="goMall">
      <text class="quick-index">01</text>
      <text class="quick-title">产品购买</text>
      <text class="quick-desc">选购、加购、订单确认</text>
    </button>
    <button class="quick-card" bindtap="goTrace">
      <text class="quick-index">02</text>
      <text class="quick-title">批次溯源</text>
      <text class="quick-desc">扫码/批次号查询</text>
    </button>
    <button class="quick-card" bindtap="goProfile">
      <text class="quick-index">03</text>
      <text class="quick-title">预约会员</text>
      <text class="quick-desc">研学、参访、服务记录</text>
    </button>
  </view>

  <view class="section-title">
    <text>臻博园手机服务</text>
    <text>官网同源 信息一致</text>
  </view>
  <view class="sync-list">
    <view class="sync-item zby-card" wx:for="{{syncMap}}" wx:key="web">
      <text class="sync-web">{{item.web}}</text>
      <text class="sync-arrow">→</text>
      <view>
        <text class="sync-mini">{{item.mini}}</text>
        <text class="sync-component">{{item.component}}</text>
      </view>
    </view>
  </view>

  <view class="section-title">
    <text>基地状态</text>
    <text>黄村坝</text>
  </view>
  <view class="stat-panel zby-card">
    <view class="stat-item" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
      <text class="stat-note">{{item.note}}</text>
    </view>
  </view>

  <view class="section-title">
    <text>基地精选内容</text>
    <text>移动端服务入口</text>
  </view>
  <swiper class="content-swiper" indicator-dots autoplay circular>
    <swiper-item wx:for="{{cards}}" wx:key="key">
      <view class="content-card" data-title="{{item.title}}" bindtap="showCard">
        <image src="{{item.image}}" mode="aspectFill" />
        <view class="content-mask">
          <text>{{item.title}}</text>
          <text>{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="section-title">
    <text>基地精选</text>
    <text bindtap="goMall">全部商品</text>
  </view>
  <view class="product-preview">
    <view class="mini-product zby-card" wx:for="{{products}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" />
      <view>
        <text class="mini-product-name">{{item.name}}</text>
        <text class="mini-product-price">¥ {{item.price}}</text>
      </view>
    </view>
  </view>
</view>
