.hero {
  position: relative;
  height: 540rpx;
  color: #fff;
}

.hero-bg,
.hero-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  background: linear-gradient(180deg, rgba(8, 25, 19, 0.18), rgba(8, 25, 19, 0.9));
}

.hero-content {
  position: relative;
  z-index: 2;
  height: 100%;
  padding: 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.hero-logo {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: auto;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
}

.hero-kicker {
  color: #d7b86d;
  font-size: 22rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-copy {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.quick-card {
  min-height: 168rpx;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  text-align: left;
  background: #fffaf2;
  box-shadow: 0 14rpx 38rpx rgba(31, 42, 36, 0.08);
}

.quick-index {
  color: #c69a49;
  font-size: 20rpx;
  font-weight: 900;
}

.quick-title {
  display: block;
  margin-top: 10rpx;
  color: #173d2b;
  font-size: 26rpx;
  font-weight: 900;
}

.quick-desc {
  display: block;
  margin-top: 8rpx;
  color: #647069;
  font-size: 21rpx;
  line-height: 1.35;
}

.sync-list {
  display: grid;
  gap: 14rpx;
}

.sync-item {
  display: grid;
  grid-template-columns: 1fr 44rpx 1fr;
  gap: 12rpx;
  align-items: center;
  padding: 22rpx;
}

.sync-web,
.sync-mini {
  color: #173d2b;
  font-size: 24rpx;
  font-weight: 900;
}

.sync-arrow {
  color: #c69a49;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.sync-component {
  display: block;
  margin-top: 6rpx;
  color: #647069;
  font-size: 20rpx;
}

.stat-panel {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 18rpx;
  background:
    linear-gradient(135deg, rgba(13, 43, 32, 0.94), rgba(23, 61, 43, 0.84)),
    url("/images/zhenboyuan/base-close.jpg") center / cover;
}

.stat-item {
  min-height: 108rpx;
  padding: 14rpx 8rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #fff;
  text-align: center;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.stat-label,
.stat-note {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
}

.stat-note {
  color: #d7b86d;
}

.content-swiper {
  height: 360rpx;
}

.content-card {
  position: relative;
  height: 340rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.content-card image,
.content-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.content-mask {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28rpx;
  color: #fff;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(8, 25, 19, 0.84));
}

.content-mask text:first-child {
  font-size: 34rpx;
  font-weight: 900;
}

.content-mask text:last-child {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
}

.product-preview {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.mini-product image {
  width: 100%;
  height: 210rpx;
}

.mini-product view {
  padding: 18rpx;
}

.mini-product-name {
  display: block;
  min-height: 68rpx;
  color: #173d2b;
  font-size: 25rpx;
  font-weight: 900;
}

.mini-product-price {
  display: block;
  margin-top: 8rpx;
  color: #8d2018;
  font-size: 28rpx;
  font-weight: 900;
}
