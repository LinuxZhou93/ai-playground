<view class="page-shell mall-shell">
  <view class="mall-hero zby-card">
    <image src="/images/zhenboyuan/product-spore.jpg" mode="aspectFit" />
    <view>
      <text class="hero-kicker">Zhenboyuan Products</text>
      <text class="hero-title">臻萃系列商城</text>
      <text class="hero-copy">臻萃系列产品支持在线选购、批次溯源和会员复购服务。</text>
    </view>
  </view>

  <scroll-view class="cat-scroll" scroll-x>
    <button
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat-pill {{activeCat === item ? 'active' : ''}}"
      data-cat="{{item}}"
      bindtap="switchCat"
    >{{item}}</button>
  </scroll-view>

  <view class="product-list">
    <view class="product-card zby-card" wx:for="{{shownProducts}}" wx:key="id">
      <image class="product-img" src="{{item.image}}" mode="aspectFill" />
      <view class="product-body">
        <text class="product-cat">{{item.cat}}</text>
        <text class="product-name">{{item.name}}</text>
        <text class="product-desc">{{item.desc}}</text>
        <view class="tag-row">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="product-actions">
          <text class="price">¥ {{item.price}}</text>
          <view>
            <button class="small-btn ghost" data-id="{{item.id}}" bindtap="addCart">加购</button>
            <button class="small-btn" data-id="{{item.id}}" bindtap="buyNow">下单</button>
          </view>
        </view>
        <button class="trace-link" data-id="{{item.id}}" bindtap="showTrace">查看批次溯源</button>
      </view>
    </view>
  </view>

  <view class="cart-bar" wx:if="{{cartCount > 0}}">
    <view>
      <text>购物车 {{cartCount}} 件</text>
      <text>¥ {{cartAmount}}</text>
    </view>
    <button bindtap="checkout">去结算</button>
  </view>
</view>
