.mall-shell {
  padding-bottom: 150rpx;
}

.mall-hero {
  min-height: 300rpx;
  display: grid;
  grid-template-columns: 220rpx 1fr;
  gap: 22rpx;
  align-items: center;
  padding: 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 250, 242, 0.96), rgba(244, 236, 220, 0.92));
}

.mall-hero image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  background: #efe6d7;
}

.hero-kicker {
  color: #c69a49;
  font-size: 21rpx;
  font-weight: 900;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  color: #173d2b;
  font-size: 42rpx;
  font-weight: 900;
}

.hero-copy {
  display: block;
  margin-top: 12rpx;
  color: #647069;
  font-size: 23rpx;
  line-height: 1.45;
}

.cat-scroll {
  white-space: nowrap;
  margin: 26rpx 0 18rpx;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  color: #647069;
  background: rgba(23, 61, 43, 0.08);
  font-size: 24rpx;
  font-weight: 800;
}

.cat-pill.active {
  color: #fff;
  background: #173d2b;
}

.product-list {
  display: grid;
  gap: 20rpx;
}

.product-card {
  display: grid;
  grid-template-columns: 230rpx 1fr;
  gap: 18rpx;
  padding: 18rpx;
}

.product-img {
  width: 230rpx;
  height: 260rpx;
  border-radius: 14rpx;
  background: #efe6d7;
}

.product-cat {
  color: #c69a49;
  font-size: 20rpx;
  font-weight: 900;
}

.product-name {
  display: block;
  margin-top: 8rpx;
  color: #173d2b;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.product-desc {
  display: block;
  margin-top: 8rpx;
  color: #647069;
  font-size: 22rpx;
  line-height: 1.38;
}

.product-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.price {
  color: #8d2018;
  font-size: 32rpx;
  font-weight: 900;
}

.small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 18rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #173d2b;
  font-size: 22rpx;
  font-weight: 900;
}

.small-btn.ghost {
  color: #173d2b;
  background: rgba(23, 61, 43, 0.08);
}

.trace-link {
  justify-content: flex-start;
  margin-top: 12rpx;
  color: #8f7442;
  font-size: 22rpx;
  font-weight: 800;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 124rpx;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  padding: 16rpx 18rpx 16rpx 24rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(8, 25, 19, 0.92);
  box-shadow: 0 22rpx 60rpx rgba(8, 25, 19, 0.24);
}

.cart-bar text {
  display: block;
  font-size: 23rpx;
  font-weight: 800;
}

.cart-bar text:last-child {
  color: #d7b86d;
}

.cart-bar button {
  min-height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #251909;
  background: #d7b86d;
  font-size: 24rpx;
  font-weight: 900;
}
