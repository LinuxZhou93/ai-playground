<view class="page-shell profile-shell">
  <view class="member-card zby-card">
    <image src="/images/zhenboyuan/logo.png" mode="aspectFit" />
    <view>
      <text class="member-name">臻博园会员</text>
      <text class="member-id">会员编号 ZBY-2026-001</text>
      <text class="member-copy">预约、订单、溯源和会员服务记录集中保存，常用信息随时可查。</text>
    </view>
  </view>

  <view class="record-grid">
    <view class="record-card zby-card" wx:for="{{records}}" wx:key="label">
      <text>{{item.value}}</text>
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="section-title">
    <text>基地参访与活动预约</text>
    <text>服务记录</text>
  </view>
  <view class="tour-list">
    <view class="tour-card zby-card" wx:for="{{tours}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" />
      <view class="tour-body">
        <text class="tour-name">{{item.name}}</text>
        <text class="tour-meta">{{item.time}} · {{item.seats}}</text>
        <button class="zby-btn" data-name="{{item.name}}" bindtap="book">立即预约</button>
      </view>
    </view>
  </view>

  <view class="section-title">
    <text>常用服务</text>
    <text>便捷办理</text>
  </view>
  <view class="service-grid">
    <button class="service-card zby-card" bindtap="goMall">
      <text>产品复购</text>
      <text>商城商品、购物车、订单记录</text>
    </button>
    <button class="service-card zby-card" bindtap="goTrace">
      <text>溯源记录</text>
      <text>批次查询、扫码结果、质检信息</text>
    </button>
    <button class="service-card zby-card" data-name="中医康养服务" bindtap="book">
      <text>康养咨询</text>
      <text>睡眠康养、体质辨识、会员回访</text>
    </button>
    <button class="service-card zby-card" data-name="企业基地参访" bindtap="book">
      <text>企业参访</text>
      <text>基地考察、合作洽谈、活动接待</text>
    </button>
  </view>

  <view class="section-title">
    <text>服务说明</text>
    <text>清晰可查</text>
  </view>
  <view class="logic-card zby-card">
    <view wx:for="{{syncMap}}" wx:key="web">
      <text>{{item.web}}</text>
      <text>{{item.mini}}</text>
    </view>
  </view>
</view>
