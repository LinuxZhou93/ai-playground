.profile-shell {
  padding-bottom: 60rpx;
}

.member-card {
  display: grid;
  grid-template-columns: 128rpx 1fr;
  gap: 24rpx;
  align-items: center;
  padding: 28rpx;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(13, 43, 32, 0.96), rgba(141, 32, 24, 0.78)),
    url("/images/zhenboyuan/base-wide.jpg") center / cover;
}

.member-card image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
}

.member-name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.member-id,
.member-copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.45;
}

.record-grid,
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.record-card {
  padding: 22rpx 12rpx;
  text-align: center;
}

.record-card text:first-child {
  display: block;
  color: #173d2b;
  font-size: 38rpx;
  font-weight: 900;
}

.record-card text:last-child {
  display: block;
  margin-top: 4rpx;
  color: #647069;
  font-size: 21rpx;
}

.tour-list {
  display: grid;
  gap: 18rpx;
}

.tour-card {
  display: grid;
  grid-template-columns: 220rpx 1fr;
  gap: 18rpx;
  padding: 18rpx;
}

.tour-card image {
  width: 220rpx;
  height: 180rpx;
  border-radius: 14rpx;
}

.tour-name {
  display: block;
  color: #173d2b;
  font-size: 29rpx;
  font-weight: 900;
}

.tour-meta {
  display: block;
  margin-top: 8rpx;
  color: #647069;
  font-size: 23rpx;
}

.tour-body .zby-btn {
  margin-top: 18rpx;
  min-height: 62rpx;
  font-size: 23rpx;
}

.service-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.service-card {
  min-height: 176rpx;
  padding: 24rpx;
  text-align: left;
}

.service-card text:first-child {
  display: block;
  color: #173d2b;
  font-size: 29rpx;
  font-weight: 900;
}

.service-card text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #647069;
  font-size: 22rpx;
  line-height: 1.4;
}

.logic-card {
  padding: 24rpx;
}

.logic-card view {
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 42, 36, 0.1);
}

.logic-card view:last-child {
  border-bottom: 0;
}

.logic-card text:first-child {
  color: #8f7442;
  font-size: 22rpx;
  font-weight: 900;
}

.logic-card text:last-child {
  color: #173d2b;
  font-size: 23rpx;
  font-weight: 800;
}
