.trace-hero {
  position: relative;
  height: 420rpx;
  color: #fff;
}

.trace-hero image,
.trace-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.trace-mask {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(8, 25, 19, 0.06), rgba(8, 25, 19, 0.88));
}

.trace-kicker {
  color: #d7b86d;
  font-size: 22rpx;
  font-weight: 900;
}

.trace-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.trace-copy {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.query-panel,
.result-card,
.timeline,
.after-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-title,
.result-label,
.after-card text:first-child {
  display: block;
  color: #173d2b;
  font-size: 30rpx;
  font-weight: 900;
}

.query-row {
  display: grid;
  grid-template-columns: 1fr 150rpx;
  gap: 12rpx;
  margin-top: 18rpx;
}

.query-row input {
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #173d2b;
  background: #f3efe8;
  font-size: 25rpx;
  font-weight: 800;
}

.query-row button,
.scan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border-radius: 14rpx;
  color: #fff;
  background: #8d2018;
  font-size: 25rpx;
  font-weight: 900;
}

.scan-btn {
  margin-top: 14rpx;
  color: #173d2b;
  background: rgba(23, 61, 43, 0.08);
}

.result-card {
  background:
    linear-gradient(135deg, rgba(23, 61, 43, 0.94), rgba(13, 43, 32, 0.98)),
    url("/images/zhenboyuan/base-close.jpg") center / cover;
  color: #fff;
}

.result-label {
  color: #d7b86d;
  font-size: 23rpx;
}

.result-code {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.result-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.5;
}

.timeline {
  display: grid;
  gap: 22rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 58rpx 1fr;
  gap: 18rpx;
  align-items: start;
}

.timeline-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #251909;
  background: #d7b86d;
  font-size: 24rpx;
  font-weight: 900;
}

.timeline-title {
  display: block;
  color: #173d2b;
  font-size: 27rpx;
  font-weight: 900;
}

.timeline-desc,
.after-card text:nth-child(2) {
  display: block;
  margin-top: 8rpx;
  color: #647069;
  font-size: 23rpx;
  line-height: 1.45;
}

.after-card .zby-btn {
  margin-top: 20rpx;
}
