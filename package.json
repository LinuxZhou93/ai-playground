{
  "name": "ai-playground",
  "version": "2.0.0",
  "description": "科技特长生培养系统(Titan AI)",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win",
    "vercel-build": "cd openmaic-core && corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install && pnpm run build",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report test-results/html",
    "test:auth": "playwright test tests/auth.spec.js",
    "test:auth:headed": "playwright test tests/auth.spec.js --headed"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.4",
  "build": {
    "appId": "com.zhoulin.aiplayground",
    "productName": "TitanAI",
    "files": [
      "**/*",
      "!openmaic-core/**",
      "!psyche_x_system/**",
      "!**/venv/**",
      "!**/.venv/**",
      "!**/__pycache__/**",
      "!**/.git/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "需要开启麦克风权限，以便您可以使用智能语音跟虚拟老师互动。",
        "NSCameraUsageDescription": "需要开启摄像头权限，以便 AI 具备图像视觉沟通能力。"
      }
    },
    "dmg": {
      "title": "安装 Titan AI",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 128,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Titan AI",
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@volcengine/openapi": "^1.36.0",
    "aws4": "^1.13.2",
    "body-parser": "^2.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "express": "^5.2.1",
    "jsdom": "^29.0.1",
    "msedge-tts": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1"
  },
  "main": "main-electron.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
