    "items": [
        {
            "id": "logic_001",
            "type": "choice-single",
            "category": "logic",
            "difficulty": 1,
            "tags": [
                "pattern",
                "vision"
            ],
            "prompt": "观察以下数列的规律，找出缺失的数字：\n16, 06, 68, 88, ?, 98\n(提示：尝试改变你的观察角度)",
            "options": [
                {
                    "id": "A",
                    "text": "78"
                },
                {
                    "id": "B",
                    "text": "87"
                },
                {
                    "id": "C",
                    "text": "89"
                },
                {
                    "id": "D",
                    "text": "90"
                }
            ],
            "correct_response": "B",
            "feedback": {
                "correct": "Excellent! You realized that flipping the numbers 180 degrees reveals the sequence: 91, 90, 89, 88, 87, 86.",
                "incorrect": "Try looking at the numbers upside down."
            }
        },
        {
            "id": "logic_002",
            "type": "choice-single",
            "category": "logic",
            "difficulty": 2,
            "tags": [
                "deduction"
            ],
            "prompt": "由A、B、C、D四人参加学校编程比赛。已知：\n1. A说：B是第一名。\n2. B说：D是第一名。\n3. C说：我不是第一名。\n4. D说：B在撒谎。\n如果只有一人说了真话，谁是第一名？",
            "options": [
                {
                    "id": "A",
                    "text": "A"
                },
                {
                    "id": "B",
                    "text": "B"
                },
                {
                    "id": "C",
                    "text": "C"
                },
                {
                    "id": "D",
                    "text": "D"
                }
            ],
            "correct_response": "C",
            "feedback": {
                "correct": "Correct reasoning: If C is first, then C's statement 'I am not first' is false. A says B is first (False). B says D is first (False). D says B lies (True). So only D speaks truth.",
                "incorrect": "Analyze each person's statement assuming they are the only truth-teller."
            }
        },
        {
            "id": "math_001",
            "type": "input-number",
            "category": "math",
            "difficulty": 3,
            "tags": [
                "olympiad",
                "algebra"
            ],
            "prompt": "定义运算 a ⊗ b = a × b + a - b。若 3 ⊗ x = 27，求 x 的值。",
            "options": [],
            "correct_response": "12",
            "feedback": {
                "correct": "正确！3×x + 3 - x = 27 => 2x + 3 = 27 => 2x = 24 => x = 12",
                "incorrect": "将 a=3 代入公式，列出方程 3x + 3 - x = 27，然后求解。"
            }
        },
        {
            "id": "coding_scratch_001",
            "type": "choice-single",
            "category": "coding",
            "difficulty": 1,
            "tags": [
                "scratch",
                "loop"
            ],
            "prompt": "在 Scratch 中，如果想让角色重复执行某个动作 10 次，应该使用哪个积木块？",
            "options": [
                {
                    "id": "A",
                    "text": "重复执行 (10) 次"
                },
                {
                    "id": "B",
                    "text": "如果...那么"
                },
                {
                    "id": "C",
                    "text": "等待 (10) 秒"
                },
                {
                    "id": "D",
                    "text": "重复执行直到..."
                }
            ],
            "correct_response": "A",
            "feedback": {
                "correct": "正确！'重复执行 (10) 次' 积木块可以让代码块重复执行指定次数。",
                "incorrect": "想一想哪个积木块可以控制重复次数。"
            }
        },
        {
            "id": "coding_py_002",
            "type": "choice-single",
            "category": "coding",
            "difficulty": 2,
            "tags": [
                "python",
                "list"
            ],
            "prompt": "在 Python 中，以下哪个代码可以正确地将列表 [1, 2, 3] 中的每个元素都乘以 2？",
            "options": [
                {
                    "id": "A",
                    "text": "list * 2"
                },
                {
                    "id": "B",
                    "text": "[x * 2 for x in list]"
                },
                {
                    "id": "C",
                    "text": "list.multiply(2)"
                },
                {
                    "id": "D",
                    "text": "map(2, list)"
                }
            ],
            "correct_response": "B",
            "feedback": {
                "correct": "正确！列表推导式 [x * 2 for x in list] 是 Python 中处理列表元素的优雅方式。",
                "incorrect": "回忆一下 Python 的列表推导式（List Comprehension）语法。"
            }
        },
        {
            "id": "coding_py_001",
            "type": "coding-block",
            "category": "coding",
            "difficulty": 2,
            "tags": [
                "python",
                "debug"
            ],
            "prompt": "修复以下 Python 代码，使其能够正确计算斐波那契数列的第 n 项。",
            "code_initial": "def fib(n):\n    if n <= 1:\n        return n\n    else:\n        return fib(n-1) + fib(n-2)",
            "correct_pattern": "fib",
            "feedback": {
                "correct": "代码逻辑正确！这是递归实现斐波那契数列的经典方法。",
                "incorrect": "检查基础情况（base case）是否正确。"
            }
        },
        {
            "id": "eng_vex_001",
            "type": "choice-single",
            "category": "engineering",
            "difficulty": 2,
            "tags": [
                "vex",
                "robotics"
            ],
            "prompt": "在 VEX 机器人比赛中，如果你想让机器人在碰到障碍物时停止，应该使用哪种传感器？",
            "options": [
                {
                    "id": "A",
                    "text": "超声波传感器 (Ultrasonic Sensor)"
                },
                {
                    "id": "B",
                    "text": "碰撞开关 (Bumper Switch)"
                },
                {
                    "id": "C",
                    "text": "陀螺仪 (Gyroscope)"
                },
                {
                    "id": "D",
                    "text": "颜色传感器 (Color Sensor)"
                }
            ],
            "correct_response": "B",
            "feedback": {
                "correct": "正确！碰撞开关在接触到物体时会触发，非常适合检测物理碰撞。",
                "incorrect": "想一想哪种传感器是通过物理接触来工作的。"
            }
        },
        {
            "id": "eng_3d_001",
            "type": "choice-single",
            "category": "engineering",
            "difficulty": 1,
            "tags": [
                "3d-modeling",
                "design"
            ],
            "prompt": "在 3D 建模软件（如 Tinkercad）中，如果想要创建一个空心的立方体，应该使用什么操作？",
            "options": [
                {
                    "id": "A",
                    "text": "复制 (Duplicate)"
                },
                {
                    "id": "B",
                    "text": "组合 (Group)"
                },
                {
                    "id": "C",
                    "text": "挖空 (Hole)"
                },
                {
                    "id": "D",
                    "text": "旋转 (Rotate)"
                }
            ],
            "correct_response": "C",
            "feedback": {
                "correct": "正确！使用'挖空'功能可以从实体中减去体积，创建空心结构。",
                "incorrect": "思考一下如何从实体中移除部分材料。"
            }
        },
        {
            "id": "eng_001",
            "type": "choice-single",
            "category": "engineering",
            "difficulty": 1,
            "tags": [
                "electronics"
            ],
            "prompt": "在电路中，为了防止 LED 灯烧毁，通常需要串联哪种元件来限制电流？",
            "options": [
                {
                    "id": "A",
                    "text": "电容器 (Capacitor)"
                },
                {
                    "id": "B",
                    "text": "电阻器 (Resistor)"
                },
                {
                    "id": "C",
                    "text": "三极管 (Transistor)"
                },
                {
                    "id": "D",
                    "text": "二极管 (Diode)"
                }
            ],
            "correct_response": "B",
            "feedback": {
                "correct": "正确！电阻器可以限制通过 LED 的电流，保护它不被烧毁。",
                "incorrect": "根据欧姆定律，想一想哪种元件可以限制电流。"
            }
        },
        {
            "id": "knowledge_001",
            "type": "choice-single",
            "category": "logic",
            "difficulty": 1,
            "tags": [
                "science",
                "physics"
            ],
            "prompt": "以下哪个不是可再生能源？",
            "options": [
                {
                    "id": "A",
                    "text": "太阳能"
                },
                {
                    "id": "B",
                    "text": "风能"
                },
                {
                    "id": "C",
                    "text": "煤炭"
                },
                {
                    "id": "D",
                    "text": "水能"
                }
            ],
            "correct_response": "C",
            "feedback": {
                "correct": "正确！煤炭是化石燃料，属于不可再生能源。",
                "incorrect": "想一想哪种能源用完就无法再生。"
            }
        },
        {
            "id": "creativity_001",
            "type": "choice-single",
            "category": "logic",
            "difficulty": 2,
            "tags": [
                "innovation",
                "design-thinking"
            ],
            "prompt": "如果你要设计一个帮助老年人的智能设备，以下哪个功能最重要？",
            "options": [
                {
                    "id": "A",
                    "text": "炫酷的外观设计"
                },
                {
                    "id": "B",
                    "text": "简单易用的操作界面"
                },
                {
                    "id": "C",
                    "text": "最新的高科技功能"
                },
                {
                    "id": "D",
                    "text": "便宜的价格"
                }
            ],
            "correct_response": "B",
            "feedback": {
                "correct": "正确！用户体验设计的核心是'以人为本'，老年人最需要的是简单易用。",
                "incorrect": "想一想老年人使用科技产品时最大的困难是什么。"
            }
        }
    ]
}
]
