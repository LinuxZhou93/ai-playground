    <script>
        function runTrace(type) {
            const modal = document.getElementById('trace-modal');
            const title = document.getElementById('trace-title');
            const timeline = document.getElementById('trace-timeline-container');
            
            let html = '';
            if (type === 'spore') {
                title.innerText = '臻博园牌破壁灵芝孢子粉 (批次: ZZ-20260508-A)';
                html = `
                    <div class="trace-node">
                        <div class="trace-node-time">2025年6月10日</div>
                        <div class="trace-node-title">菌种繁育与溯源 (352规范)</div>
                        <div class="trace-node-desc">选用四川彭州道地川芝优良菌种，进行脱毒提纯，确认菌种活性与遗传特征，符合352菌苗选育标准。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2025年7月15日</div>
                        <div class="trace-node-title">林下野生椴木种植 (352规范)</div>
                        <div class="trace-node-desc">椴木接种，置于黄村坝林下天然仿野生种植基地。实施5G IoT实时生态监测，基地海拔1050米，无化学农药。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2025年11月20日</div>
                        <div class="trace-node-title">孢子粉套袋采收 (352规范)</div>
                        <div class="trace-node-desc">灵芝成熟并喷粉，采用物理套袋法无尘收集孢子粉。检测记录表明空气优良，无化学除草剂污染。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2026年3月15日</div>
                        <div class="trace-node-title">超低温物理破壁与检验</div>
                        <div class="trace-node-desc">于GMP十万级洁净车间进行超低温剪切力物理破壁。SGS检测报告：破壁率达99.2%，多糖含量高出国家标准44%。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2026年5月8日</div>
                        <div class="trace-node-title">产品质检入库与批次上链</div>
                        <div class="trace-node-desc">贴标出厂，分配专属352溯源防伪码，批次数据同步写入四川省道地药材全产业链追溯区块链平台。</div>
                    </div>
                `;
            } else {
                title.innerText = '臻博园参灵枣仁膏 (批次: ZZ-20260515-B)';
                html = `
                    <div class="trace-node">
                        <div class="trace-node-time">2025年7月1日</div>
                        <div class="trace-node-title">人参及枣仁道地药材采购</div>
                        <div class="trace-node-desc">长白山五年生人参、河北道地酸枣仁入库，执行352原材料初加工和农残、重金属严苛筛查。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2025年11月10日</div>
                        <div class="trace-node-title">核心灵芝原料收获与产地加工</div>
                        <div class="trace-node-desc">彭州黄村坝基地仿野生椴木灵芝采收。经切片、超微粉碎等产地初加工处理，符合352栽培与初加工规范。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2026年2月18日</div>
                        <div class="trace-node-title">非遗古法“八繁”慢火熬制</div>
                        <div class="trace-node-desc">名中医师配伍，历经“煎、煮、滤、浓、收”等十二道工序，慢火收膏。总三萜及甾醇高出国家检测参考值170%。</div>
                    </div>
                    <div class="trace-node">
                        <div class="trace-node-time">2026年5月15日</div>
                        <div class="trace-node-title">品质成品入库与一键上链</div>
                        <div class="trace-node-desc">密封瓶装，质检合格，生成批次数字身份证，接入全产业链质量追溯网络。</div>
                    </div>
                `;
            }
            
            timeline.innerHTML = html;
            modal.classList.add('active');
        }

        function closeTrace() {
            document.getElementById('trace-modal').classList.remove('active');
        }
    </script>

