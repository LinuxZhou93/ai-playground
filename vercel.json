{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "openmaic-core/.next",
  "rewrites": [
    {
      "source": "/mozi_lab.html",
      "destination": "/mozi_lab.html"
    },
    {
      "source": "/mozi_atlas.html",
      "destination": "/mozi_atlas.html"
    },
    {
      "source": "/mozi_topic_gfiber.html",
      "destination": "/mozi_topic_gfiber.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/mozi_index.js",
      "destination": "/mozi_index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/openmaic-core/.next/$1",
      "checkInternalRoutes": false
    }
  ]
}
