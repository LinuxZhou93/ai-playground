{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "XMP_PUBLIC_BASE=/xmpgame/ npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/model.mjs": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/xmpgame/v1/status", "destination": "/api/model?route=status" },
    { "source": "/xmpgame/v1/tasks", "destination": "/api/model?route=tasks" },
    { "source": "/xmpgame/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/xmpgame/station/:path*", "destination": "/index.html" },
    { "source": "/xmpgame", "destination": "/index.html" },
    { "source": "/xmpgame/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/xmpgame/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
